# Core storage
GYM_DATA_DIR=./data
GYM_DATABASE_PATH=./data/gym-video-logger.db
GYM_MAX_FILE_SIZE_BYTES=21474836480
GYM_MAX_SESSION_SIZE_BYTES=107374182400
GYM_MAX_PHOTO_SIZE_BYTES=15728640
GYM_UPLOAD_CONCURRENCY=2
GYM_FFMPEG_PATH=ffmpeg
GYM_FFPROBE_PATH=ffprobe
GYM_SEED_SAMPLE_DATA=true

# YouTube. Mock mode is the safe default for first-run development.
GYM_YOUTUBE_MOCK_MODE=true
GYM_YOUTUBE_PROCESSING_POLL_SECONDS=20
GYM_YOUTUBE_CLIENT_SECRET_PATH=./secrets/youtube-client-secret.json
GYM_YOUTUBE_TOKEN_PATH=./secrets/youtube-token.json
GYM_YOUTUBE_PRIVACY_STATUS=unlisted
GYM_YOUTUBE_TITLE_TEMPLATE={session_name} — {workout_date}
GYM_YOUTUBE_DESCRIPTION_TEMPLATE={notes}\n\n{chapters}

# Source clips and the stitched output are deleted only after YouTube finishes processing.
GYM_DELETE_ORIGINALS_AFTER_SUCCESS=true
GYM_DELETE_OUTPUT_AFTER_SUCCESS=true

# Remove camera setup and pickup time from each clip before it is stitched.
# Short clips always retain at least 3 seconds.
GYM_TRIM_START_SECONDS=5
GYM_TRIM_END_SECONDS=5

# Phone push notifications for the installed PWA. The VAPID key is generated locally.
GYM_WEB_PUSH_VAPID_PRIVATE_KEY_PATH=./data/web-push-vapid-private.pem
GYM_WEB_PUSH_CONTACT_EMAIL=mailto:you@example.com

# Accounts and sign-in. Set GYM_COOKIE_SECURE=true when serving over HTTPS (for example behind
# Caddy) so the session cookie is only sent over encrypted connections.
GYM_COOKIE_SECURE=false
# Days without using the app before a sign-in ends. Each day the app is used restarts the count,
# so a phone in regular use stays signed in until the person signs out.
GYM_SESSION_DAYS=90
# Cookies are shared between ports on the same host. Give a second instance on this host (such as
# a test copy) its own name so signing in to one does not sign you out of the other.
GYM_SESSION_COOKIE=gym_session
# The first account becomes admin and owns any data created before accounts existed. It can be
# created in the browser only when an invite code is set; otherwise use
# `python -m app.manage create-user` from this folder. It is allowed even with registration off.
GYM_REGISTRATION_INVITE_CODE=
# Let further people sign up (with the invite code, if one is set). Off by default.
# This and GYM_VIDEO_UPLOADS are starting values: once an admin changes them in the in-app
# Admin console, the console's choice wins and these lines are ignored.
GYM_ALLOW_REGISTRATION=false
# Who may upload workout videos: off, admin, or everyone. YouTube uploads share one channel,
# so only admins (the first account) may use them by default.
GYM_VIDEO_UPLOADS=admin
# Serve the interactive API docs at /docs. Keep off on a public server.
GYM_API_DOCS=false
