# systemd unit for Gym Logger (FastAPI backend, serves the built PWA).
# Installed to /etc/systemd/system/gym-logger.service by deploy/setup-ubuntu.sh.
# Full walkthrough: docs/DEPLOY-ORACLE-CLOUD.md

[Unit]
Description=Gym Logger (FastAPI + SQLite, multi-user)
Documentation=https://github.com/ejbolts/Gym-video-logger/blob/master/docs/DEPLOY-ORACLE-CLOUD.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=gymlogger
Group=gymlogger
WorkingDirectory=/opt/gym-logger

# Production configuration. Must be readable by the gymlogger user (the app
# re-reads .env from its working directory), so keep it root:gymlogger 0640.
EnvironmentFile=/opt/gym-logger/.env

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Caches (for example OCR model files, if any are fetched lazily) go into the writable data directory.
Environment=XDG_CACHE_HOME=/opt/gym-logger/data/cache

# Apply database migrations before the server starts. No-op when already at head.
# Runs from WorkingDirectory so alembic reads /opt/gym-logger/.env and the same database as the app.
ExecStartPre=/opt/gym-logger/.venv/bin/alembic upgrade head

# Exactly one worker: the upload processor and the YouTube/push pollers run in-process.
# --proxy-headers and --forwarded-allow-ips trust X-Forwarded-Proto from Caddy (127.0.0.1) so
# secure cookies and generated URLs use https. Do not widen --forwarded-allow-ips.
ExecStart=/opt/gym-logger/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1

Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# Only the database, machine photos, uploads/outputs (under data/) and the YouTube/secrets files are writable.
ReadWritePaths=/opt/gym-logger/data /opt/gym-logger/secrets
ProtectHome=true
# Private /tmp and /var/tmp. ffmpeg and the app write their scratch files under data/
# (normalized/ and outputs/), so this does not affect video processing; any file in /tmp is private to this service.
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
