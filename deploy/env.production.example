# Gym Logger production configuration (Oracle Cloud / Ubuntu VM).
#
# deploy/setup-ubuntu.sh copies this file to /opt/gym-logger/.env ONLY when that file does not
# exist yet. Edit /opt/gym-logger/.env on the server, not this template.
#
# Format rules: systemd reads this file as an EnvironmentFile, so use plain KEY=value lines.
# Do not quote values, do not use "export", and do not put comments after a value on the same line.
#
# Before you start the service, replace every value that contains "change-me" or "you@example.com".
# setup-ubuntu.sh does not start the app while those placeholders remain.

# --- Core storage (absolute paths on the VM; keep these matching the systemd unit) ---
GYM_DATA_DIR=/opt/gym-logger/data
GYM_DATABASE_PATH=/opt/gym-logger/data/gym-video-logger.db
GYM_MAX_FILE_SIZE_BYTES=21474836480
GYM_MAX_SESSION_SIZE_BYTES=107374182400
GYM_MAX_PHOTO_SIZE_BYTES=15728640
GYM_UPLOAD_CONCURRENCY=2
GYM_FFMPEG_PATH=/usr/bin/ffmpeg
GYM_FFPROBE_PATH=/usr/bin/ffprobe

# Never seed the demo workouts on a server that holds real data.
GYM_SEED_SAMPLE_DATA=false

# --- Accounts and sign-in (multi-user cookie sessions) ---
# Secure cookies are only sent over HTTPS. Caddy provides HTTPS; keep this true in production.
GYM_COOKIE_SECURE=true
# Days without using the app before a sign-in ends; each day of use restarts the count.
GYM_SESSION_DAYS=90
# Required for every browser sign-up, including the first (admin) account.
# Generate a value with: openssl rand -base64 24
# Do not reuse the placeholder: it is published in this repository.
GYM_REGISTRATION_INVITE_CODE=change-me-to-a-long-random-string
# Lets people other than the first account sign up with the invite code. Turn sign-ups off in
# the Admin console (Settings -> Admin console) once everyone has joined.
GYM_ALLOW_REGISTRATION=true
# Who may upload workout videos: off, admin, or everyone. Re-encoding video is heavy for the
# 2-OCPU Always Free VM, so it starts off; switch it on in the Admin console when needed.
# Both values above are only starting values: the Admin console's choices override them.
GYM_VIDEO_UPLOADS=off
# The interactive API docs (/docs) describe every endpoint; keep them off in production.
GYM_API_DOCS=false

# --- YouTube ---
# Mock mode returns a deterministic fake YouTube URL and never talks to Google. It is safe for a
# first deployment, but in mock mode videos are NOT published to YouTube. Set this to false only
# after copying the OAuth client secret and token to /opt/gym-logger/secrets (see the deploy guide).
GYM_YOUTUBE_MOCK_MODE=true
GYM_YOUTUBE_PROCESSING_POLL_SECONDS=20
GYM_YOUTUBE_CLIENT_SECRET_PATH=/opt/gym-logger/secrets/youtube-client-secret.json
GYM_YOUTUBE_TOKEN_PATH=/opt/gym-logger/secrets/youtube-token.json
GYM_YOUTUBE_PRIVACY_STATUS=unlisted
GYM_YOUTUBE_TITLE_TEMPLATE={session_name} — {workout_date}
GYM_YOUTUBE_DESCRIPTION_TEMPLATE={notes}\n\n{chapters}

# Source clips and the stitched output are deleted only after YouTube finishes processing.
GYM_DELETE_ORIGINALS_AFTER_SUCCESS=true
GYM_DELETE_OUTPUT_AFTER_SUCCESS=true

# Remove camera setup and pickup time from each clip before it is stitched.
# Short clips always retain at least 3 seconds.
GYM_TRIM_START_SECONDS=5
GYM_TRIM_END_SECONDS=5

# --- Web Push (phone notifications) ---
# The VAPID private key is generated on first start and stored here. Back it up with the database.
GYM_WEB_PUSH_VAPID_PRIVATE_KEY_PATH=/opt/gym-logger/data/web-push-vapid-private.pem
# Contact address sent to push services. Use a real mailbox you read.
GYM_WEB_PUSH_CONTACT_EMAIL=mailto:you@example.com
